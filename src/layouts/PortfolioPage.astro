---
import AdaptivePortfolio from '../components/adaptive/AdaptivePortfolio';
import '../styles/global.css';
import '../styles/adaptive-shell.css';
import '../styles/mobile-shell.css';

type Props = {
  initialFieldNotesOpen?: boolean;
  initialFieldNoteSlug?: string | null;
};

const { initialFieldNotesOpen = false, initialFieldNoteSlug = null } = Astro.props;
const allowHostedShellOverride = import.meta.env.VERCEL_ENV === 'preview';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050505" />
    <script is:inline define:vars={{ allowHostedShellOverride }}>
      (() => {
        const isLocalPreview = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
        if (!isLocalPreview && !allowHostedShellOverride) return;

        const shell = new URLSearchParams(location.search).get('shell');
        if (!['mobile', 'tablet', 'desktop'].includes(shell)) return;

        document.documentElement.dataset.portfolioShellOverride = shell;
        const robots = document.createElement('meta');
        robots.name = 'robots';
        robots.content = 'noindex, nofollow';
        document.head.appendChild(robots);
      })();
    </script>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta
      name="description"
      content="Penuel Stanley-Zebulon's interactive portfolio: healthcare AI, responsible product engineering, machine learning, and human-centered systems."
    />
    <title>Penuel's Desktop</title>
  </head>
  <body>
    <AdaptivePortfolio client:load initialFieldNotesOpen={initialFieldNotesOpen} initialFieldNoteSlug={initialFieldNoteSlug} />
  </body>
</html>
